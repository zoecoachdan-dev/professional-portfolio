* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    background: #0a0c0f;
    color: #f5f7fa;
    line-height: 1.7;
}

a {
    color: inherit;
    text-decoration: none;
}

.navbar {
    width: min(1160px, 90%);
    margin: auto;
    padding: 30px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -1px;
}

.nav-links {
    display: flex;
    gap: 32px;
}

.nav-links a {
    color: #9ca3ad;
    font-size: 0.9rem;
    transition: color 0.25s ease;
}

.nav-links a:hover {
    color: #ffffff;
}

.hero {
    width: min(1160px, 90%);
    margin: auto;
    padding: 145px 0 170px;
}

.eyebrow,
.section-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 3px;
    color: #8d96a3;
    margin-bottom: 25px;
}

.hero h1 {
    max-width: 1000px;
    font-size: clamp(3.5rem, 9vw, 7.5rem);
    line-height: 0.98;
    letter-spacing: -5px;
    margin-bottom: 42px;
}

.hero-text {
    max-width: 720px;
    color: #aeb5bf;
    font-size: 1.18rem;
    line-height: 1.8;
    margin-bottom: 42px;
}

.hero-buttons,
.contact-buttons {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
}

.button {
    display: inline-block;
    padding: 14px 25px;
    border-radius: 7px;
    font-weight: 650;
    transition: transform 0.2s ease, opacity 0.2s ease;
}

.button:hover {
    transform: translateY(-2px);
    opacity: 0.88;
}

.primary {
    background: #ffffff;
    color: #0a0c0f;
}

.secondary {
    border: 1px solid #3a414b;
    color: #ffffff;
}

.intro-section {
    width: min(1160px, 90%);
    margin: auto;
    padding: 120px 0;
    border-top: 1px solid #272d35;
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 50px;
}

.intro-number {
    color: #6e7682;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 2px;
}

.intro-content {
    max-width: 900px;
}

.intro-content h2 {
    font-size: clamp(2.2rem, 5vw, 4.3rem);
    line-height: 1.08;
    letter-spacing: -2px;
    margin-bottom: 38px;
}

.intro-content p:not(.section-label) {
    max-width: 760px;
    color: #aeb5bf;
    font-size: 1.08rem;
    margin-bottom: 22px;
}

.section {
    width: min(1160px, 90%);
    margin: auto;
    padding: 125px 0;
    border-top: 1px solid #272d35;
}

.section h2 {
    max-width: 900px;
    font-size: clamp(2.2rem, 5vw, 4.3rem);
    line-height: 1.08;
    letter-spacing: -2px;
    margin-bottom: 35px;
}

.section-lead {
    max-width: 760px;
    color: #aeb5bf;
    font-size: 1.08rem;
}

.featured {
    width: 100%;
    padding-left: max(5%, calc((100% - 1160px) / 2));
    padding-right: max(5%, calc((100% - 1160px) / 2));
    background: #101318;
}

.about-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 70px;
    margin-top: 50px;
}

.about-grid p {
    color: #aeb5bf;
    font-size: 1.05rem;
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-top: 55px;
}

.card {
    padding: 34px;
    border: 1px solid #2b323b;
    border-radius: 12px;
    background: #0c0f13;
    transition: transform 0.25s ease, border-color 0.25s ease;
}

.card:hover {
    transform: translateY(-5px);
    border-color: #59616d;
}

.card-number {
    color: #737c88;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 45px;
}

.card h3 {
    font-size: 1.35rem;
    margin-bottom: 15px;
}

.card p {
    color: #9da5af;
}

.expertise-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-top: 60px;
}

.expertise-item {
    padding: 35px 45px 40px 0;
    border-top: 1px solid #2b323b;
}

.expertise-item span {
    display: block;
    color: #737c88;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 25px;
}

.expertise-item h3 {
    font-size: 1.35rem;
    margin-bottom: 12px;
}

.expertise-item p {
    max-width: 500px;
    color: #9da5af;
}

.focus-list {
    margin-top: 55px;
    border-top: 1px solid #2b323b;
}

.focus-list div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    padding: 24px 0;
    border-bottom: 1px solid #2b323b;
}

.focus-list strong {
    font-size: 1rem;
}

.focus-list span {
    color: #8f98a4;
}

.project-list {
    margin-top: 60px;
}

.project {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    padding: 40px 0;
    border-top: 1px solid #2b323b;
}

.project-info > span {
    color: #737c88;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 2px;
}

.project h3 {
    font-size: 1.7rem;
    margin: 12px 0;
}

.project p {
    max-width: 650px;
    color: #9da5af;
}

.project-status {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: #858e9a;
    white-space: nowrap;
}

.contact {
    width: min(1160px, 90%);
    margin: auto;
    padding: 150px 0;
}

.contact h2 {
    max-width: 850px;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 1;
    letter-spacing: -4px;
    margin-bottom: 30px;
}

.contact > p:not(.section-label) {
    max-width: 650px;
    color: #aeb5bf;
    font-size: 1.08rem;
    margin-bottom: 38px;
}

footer {
    width: min(1160px, 90%);
    margin: auto;
    padding: 35px 0 55px;
    border-top: 1px solid #272d35;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: #707985;
    font-size: 0.8rem;
}

footer strong {
    color: #f5f7fa;
}

@media (max-width: 800px) {

    .nav-links {
        display: none;
    }

    .hero {
        padding: 95px 0 110px;
    }

    .hero h1 {
        font-size: clamp(3.2rem, 14vw, 5rem);
        letter-spacing: -3px;
    }

    .intro-section {
        grid-template-columns: 1fr;
        gap: 25px;
        padding: 90px 0;
    }

    .about-grid,
    .cards,
    .expertise-grid {
        grid-template-columns: 1fr;
    }

    .about-grid {
        gap: 30px;
    }

    .featured {
        padding-left: 5%;
        padding-right: 5%;
    }

    .focus-list div {
        grid-template-columns: 1fr;
        gap: 5px;
    }

    .project {
        flex-direction: column;
        gap: 20px;
    }

    footer {
        flex-direction: column;
    }
}
